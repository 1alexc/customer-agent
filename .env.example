# Google Cloud & Gemini Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
SUPPORT_MODEL=gemini-2.5-flash

# Deployed Agent Runtime Resource Name (from deploy.py output)
AGENT_RESOURCE_NAME=projects/PROJECT_NUMBER/locations/us-central1/reasoningEngines/RESOURCE_ID

MODEL_ARMOR_INPUT_TEMPLATE=projects/YOUR_PROJECT_ID/locations/YOUR_REGION/templates/customer-support-input
MODEL_ARMOR_OUTPUT_TEMPLATE=projects/YOUR_PROJECT_ID/locations/YOUR_REGION/templates/customer-support-output
 
# Observability & Tracing
# Options: EVENT_ONLY (Cloud Logging), SPAN_ONLY, SPAN_AND_EVENT (both), or NO_CONTENT
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT